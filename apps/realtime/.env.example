# Copy to apps/realtime/.env
# See /.env.example at the repo root for descriptions.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000

# Providers
OPENAI_API_KEY=sk-proj-REPLACE_ME
DEEPGRAM_API_KEY=REPLACE_ME
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_DE=pNInz6obpgDQGcFmaJgB

# AWS (for Polly fallback only when running locally)
AWS_REGION=eu-central-1
# AWS_PROFILE=default     # uncomment if you use a named profile

# PostgreSQL
# Local dev:  postgres://vtm:vtm@localhost:5432/vtm
# AWS RDS:    postgres://<user>:<pass>@<host>:5432/<db>?sslmode=require
DATABASE_URL=postgres://vtm:vtm@localhost:5432/vtm

# Cognito (after terraform apply)
COGNITO_USER_POOL_ID=eu-central-1_REPLACE
COGNITO_CLIENT_ID=REPLACE_ME

# Optional: allow unauthenticated dev sessions
ALLOW_ANONYMOUS=true
