# RDS PostgreSQL (db.t4g.micro) — single-AZ, free-tier eligible.
#
# Free tier:  750 hr/month for 12 months
#             20 GB storage included
#             Backup storage up to DB size
#
# After 12 months: ~$13/month for the instance, ~$2/month for storage.
#
# We use a master-password-stored-in-SSM pattern. Terraform never sees the
# password directly — it's generated by `random_password`, written to SSM
# as a SecureString, and the EC2 instance reads it at boot.

resource "random_password" "db" {
  length           = 32
  special          = true
  override_special = "!#%^*-_=+" # avoid characters that need URL-encoding
}

resource "aws_ssm_parameter" "db_password" {
  name        = "/${var.project}/${var.environment}/DB_PASSWORD"
  description = "Auto-generated RDS master password"
  type        = "SecureString"
  value       = random_password.db.result
  overwrite   = true
}

# Security group: only the realtime EC2 can talk to the DB on 5432.
resource "aws_security_group" "rds" {
  name        = "${local.name_prefix}-rds-sg"
  description = "Postgres access from the realtime EC2 only"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "PostgreSQL from realtime EC2"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.realtime.id]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# Default VPC subnets work for single-AZ free tier. For multi-AZ later,
# create a dedicated subnet group spanning ≥2 AZs.
resource "aws_db_subnet_group" "default" {
  name       = "${local.name_prefix}-db-subnets"
  subnet_ids = data.aws_subnets.default.ids
}

resource "aws_db_instance" "main" {
  identifier = "${local.name_prefix}-pg"
  engine     = "postgres"
  # Use the major version only — RDS picks the latest available minor.
  # Pinning to a specific minor (e.g. "16.4") breaks if AWS retires it,
  # which they do every few months. Combined with auto_minor_version_upgrade
  # (default true) this keeps us on a supported minor without churn.
  engine_version    = "16"
  instance_class    = "db.t4g.micro"
  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = "vtm"
  username = "vtm"
  password = random_password.db.result
  port     = 5432

  multi_az             = false # free tier is single-AZ
  publicly_accessible  = false
  db_subnet_group_name = aws_db_subnet_group.default.name

  vpc_security_group_ids = [aws_security_group.rds.id]

  # AWS new-account Free Tier explicitly forbids backup_retention_period > 0
  # ("FreeTierRestrictionError"). For prod, set this to 7 once you're off
  # the free tier or move to a paid account plan.
  backup_retention_period = 0

  maintenance_window           = "sun:04:00-sun:05:00"
  deletion_protection          = false # set true for prod environments
  skip_final_snapshot          = true  # set false for prod
  apply_immediately            = true
  performance_insights_enabled = false # paid feature

  tags = {
    Name = "${local.name_prefix}-pg"
  }
}

# Store the full DATABASE_URL in SSM. The EC2 userdata script reads this at
# boot and writes it into /opt/vtm/.env so the Node process picks it up.
resource "aws_ssm_parameter" "database_url" {
  name        = "/${var.project}/${var.environment}/DATABASE_URL"
  description = "Postgres connection string for the realtime backend"
  type        = "SecureString"
  value       = "postgres://${aws_db_instance.main.username}:${random_password.db.result}@${aws_db_instance.main.endpoint}/${aws_db_instance.main.db_name}?sslmode=require"
  overwrite   = true
}
