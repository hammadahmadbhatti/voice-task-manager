# Copy to terraform.tfvars and fill in real values.

aws_region   = "eu-central-1"
environment  = "dev"
project      = "vtm"

# After you deploy your Vercel frontend, add its URLs here:
cognito_callback_urls = [
  "http://localhost:3000/en/auth/callback",
  "http://localhost:3000/de/auth/callback",
  # "https://your-app.vercel.app/en/auth/callback",
  # "https://your-app.vercel.app/de/auth/callback",
]
cognito_logout_urls = [
  "http://localhost:3000",
  # "https://your-app.vercel.app",
]

# Optional: SSH access (leave commented to use SSM Session Manager only)
# ec2_key_name      = "my-keypair"
# ssh_allowed_cidrs = ["203.0.113.45/32"]   # your home IP only

# Optional: custom domain for TLS via Caddy autocert
# domain_name = "vtm.example.com"

# Optional: Google OAuth — create credentials in Google Cloud Console
# google_client_id     = "..."
# google_client_secret = "..."
