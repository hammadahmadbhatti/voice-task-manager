#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/vtm-userdata.log|logger -t vtm-userdata -s 2>/dev/console) 2>&1

# ---------- packages ----------
apt-get update
apt-get install -y curl ca-certificates gnupg debian-keyring debian-archive-keyring apt-transport-https jq

# Node.js 20 (NodeSource)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# pnpm + pm2 globally
npm install -g pnpm@9 pm2@5

# Caddy (with apt repo for auto-renewal)
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | tee /etc/apt/sources.list.d/caddy-stable.list
apt-get update
apt-get install -y caddy

# CloudWatch agent
curl -fsSL https://s3.${aws_region}.amazonaws.com/amazoncloudwatch-agent-${aws_region}/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/awscw.deb
dpkg -i -E /tmp/awscw.deb || true

# ---------- application user ----------
useradd --system --create-home --shell /bin/bash vtm
install -d -o vtm -g vtm /opt/vtm

# ---------- environment file ----------
# Real provider keys come from SSM (created out-of-band by `aws ssm put-parameter`).
# Naming: /vtm/dev/OPENAI_API_KEY  etc.
# DATABASE_URL is auto-generated by Terraform and stored in SSM too.
cat > /opt/vtm/.env <<EOF
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
AWS_REGION=${aws_region}
COGNITO_USER_POOL_ID=${cognito_pool_id}
COGNITO_CLIENT_ID=${cognito_client_id}
ALLOWED_ORIGINS=https://${domain_name}
ALLOW_ANONYMOUS=false
EOF
chown vtm:vtm /opt/vtm/.env
chmod 640 /opt/vtm/.env

# Pull provider secrets + DB URL from SSM into the env file. Provider keys
# come from `infra/scripts/put-secrets.sh` (you run that once after first
# `terraform apply`). DATABASE_URL is written by Terraform itself.
for key in OPENAI_API_KEY DEEPGRAM_API_KEY ELEVENLABS_API_KEY ELEVENLABS_VOICE_ID_EN ELEVENLABS_VOICE_ID_DE DATABASE_URL; do
  value="$(aws ssm get-parameter \
    --region "${aws_region}" \
    --name "/${project}/${environment}/$key" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text 2>/dev/null || true)"
  if [ -n "$value" ] && [ "$value" != "None" ]; then
    echo "$key=$value" >> /opt/vtm/.env
  fi
done

# ---------- code deploy ----------
# This userdata creates the runtime sandbox only.
# The actual artifact ships via `infra/scripts/deploy.sh` from your laptop:
# it rsyncs the built dist + node_modules to /opt/vtm/app on this instance.
install -d -o vtm -g vtm /opt/vtm/app

# ---------- pm2 ----------
sudo -u vtm bash -lc 'pm2 startup systemd -u vtm --hp /home/vtm' || true
systemctl enable pm2-vtm || true

# ---------- Caddy ----------
%{ if domain_name != "" ~}
cat > /etc/caddy/Caddyfile <<'EOF'
${domain_name} {
    encode gzip
    reverse_proxy localhost:4000 {
        flush_interval -1
    }
}
EOF
%{ else ~}
# No domain → serve plain HTTP on :80 (development only — browsers will
# block getUserMedia on http; configure domain_name before going live).
cat > /etc/caddy/Caddyfile <<'EOF'
:80 {
    encode gzip
    reverse_proxy localhost:4000 {
        flush_interval -1
    }
}
EOF
%{ endif ~}

systemctl reload caddy || systemctl restart caddy

echo "vtm userdata complete. Now run infra/scripts/deploy.sh from your laptop."
