# env / secrets — multiple patterns to catch them at any depth
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.csv
*credentials*.csv
.aws/
secrets/
secrets.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

