# =====================================================================
# Voice Task Manager — root .env.example
# Copy this to .env at the repo root, plus apps/realtime/.env and
# apps/web/.env.local. The per-app .env files are what actually load.
# =====================================================================

# ---- LLM ----
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ---- STT ----
# Deepgram: https://console.deepgram.com — $200 free signup credit
DEEPGRAM_API_KEY=REPLACE_ME

# ---- TTS (primary) ----
# ElevenLabs: https://elevenlabs.io
ELEVENLABS_API_KEY=REPLACE_ME
# Voice ID: pick one from https://elevenlabs.io/app/voice-library
# Defaults below are good multilingual voices:
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM   # "Rachel" — English
ELEVENLABS_VOICE_ID_DE=pNInz6obpgDQGcFmaJgB   # "Adam" — multilingual

# ---- AWS (Polly fallback + DynamoDB + Cognito) ----
# Created locally with: aws configure --profile vtm
# Or read from ~/.aws/credentials by the SDK.
AWS_REGION=eu-central-1
AWS_PROFILE=default

# ---- Cognito (filled in after `terraform apply`) ----
COGNITO_USER_POOL_ID=eu-central-1_REPLACE
COGNITO_CLIENT_ID=REPLACE_ME
COGNITO_DOMAIN=vtm-auth-REPLACE.auth.eu-central-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- PostgreSQL ----
# Local dev: connects to the postgres container in docker-compose.yml
# Production: RDS Postgres in eu-central-1, sslmode=require, credentials from SSM
DATABASE_URL=postgres://vtm:vtm@localhost:5432/vtm

# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (used as NEXT_PUBLIC_*) ----
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_COGNITO_DOMAIN=vtm-auth-REPLACE.auth.eu-central-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=REPLACE_ME
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_DEFAULT_LOCALE=en
